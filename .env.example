# Copy to .env for docker compose. Every value has a safe local default except the secret key.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=cargopulse
POSTGRES_USER=cargopulse
POSTGRES_PASSWORD=cargopulse
DATABASE_URL=postgres://cargopulse:cargopulse@db:5432/cargopulse
REDIS_URL=redis://redis:6379/0

# Password shared by the one-click demo personas (admin/ops/customer/carrier@demo.cargopulse.app)
DEMO_PASSWORD=Demo@12345
